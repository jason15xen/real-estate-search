# OpenAI (api.openai.com) — single key for vision, query parsing, feature
# filtering, geocoding, and embeddings.
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-5.1                          # vision + geocoding
OPENAI_MODEL_FOR_QUERY=gpt-5.1               # /search query parsing + feature filter
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
OPENAI_TEST_MODEL=                            # optional: model for /test/compare-vision A/B

# Search behavior
SEARCH_USE_EMBEDDING_RETRIEVAL=true
SEARCH_EMBEDDING_TOP_K=200

# PostgreSQL (host values; docker-compose overrides host/port inside the network)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=real_estate

LOG_LEVEL=INFO
