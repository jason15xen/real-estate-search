# OpenAI (api.openai.com) — single key for the whole app
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_FOR_QUERY=
OPENAI_EMBEDDING_MODEL=
OPENAI_TEST_MODEL=

# Batch API for photo analysis (50% cost; true = batch-EXCLUSIVE, all photos via batches)
VISION_USE_BATCH=
VISION_BATCH_MAX_ITEMS=
VISION_BATCH_POLL_SECONDS=
# Total in-flight budget: org Batch Queue Limit minus ~10% headroom (plan minimum 90000)
VISION_BATCH_QUEUE_TOKENS=
# Size of one batch (input-token estimate); queue fills with as many of these as fit
VISION_BATCH_MAX_TOKENS=
# Images per grouped request (prompt sent once per group; failed groups retry 5 then 1)
VISION_GROUP_MAX_IMAGES=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
LOG_LEVEL=
