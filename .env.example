# OpenAI (api.openai.com) — single key for the whole app
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_FOR_QUERY=
OPENAI_EMBEDDING_MODEL=
OPENAI_TEST_MODEL=

# Batch API for photo analysis (50% cost, async; blank = off/defaults)
VISION_USE_BATCH=
VISION_BATCH_THRESHOLD=
VISION_BATCH_MAX_ITEMS=
VISION_BATCH_POLL_SECONDS=
# Total in-flight budget: your org's Batch Queue Limit minus ~10% headroom (default 800000 for a 900k limit)
VISION_BATCH_QUEUE_TOKENS=
# Size of one batch; equal to queue budget (default) = single waves, smaller = concurrent batches
VISION_BATCH_MAX_TOKENS=
# true = big uploads WAIT for discounted batch waves (cheap, slower); blank/false = overflow drains at full price (fast)
VISION_BATCH_PATIENT=

# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
LOG_LEVEL=
