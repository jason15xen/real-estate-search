# PostGIS 16 + pgvector — the search pipeline needs both:
#   - PostGIS  : spatial queries (Phase 3 proximity)
#   - pgvector : feature-embedding similarity search (Phase 4 candidate retrieval)
#
# The postgis image is built on the official postgres image, which already has
# the PGDG apt repo configured — so pgvector installs as a package, no compile.
FROM postgis/postgis:16-3.4

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16-pgvector \
    && rm -rf /var/lib/apt/lists/*
